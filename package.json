{
  "name": "mms",
  "private": true,
  "version": "1.0.3",
  "description": "Offline School Management (Desktop)",
  "author": "Your Company",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ec2": "powershell -ExecutionPolicy Bypass -File ./scripts/build-ec2.ps1 -Domain your-domain.com",
    "build:lightsail": "powershell -ExecutionPolicy Bypass -File ./scripts/build-ec2.ps1 -Domain your-domain.com",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e:smoke": "playwright test -c playwright.config.js",
    "e2e:report": "playwright show-report",
    "e2e:ui": "playwright test -c playwright.config.js --ui",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev:desktop": "concurrently -k \"npm:dev\" \"npm:dev:electron\"",
    "build:web": "vite build",
    "dist": "npm run build:web && electron-builder",
    "dist:portable": "npm run build:web && electron-builder --win portable",
    "build:trial14": "node scripts/set-config.js TRIAL 14 && npm run dist",
    "build:trial7": "node scripts/set-config.js TRIAL 7 && npm run dist",
    "build:full": "node scripts/set-config.js FULL 0 && npm run dist",
    "deploy:ec2:dist": "powershell -ExecutionPolicy Bypass -File ./scripts/upload-dist-to-ec2.ps1 -Host your-domain.com",
    "deploy:lightsail:dist": "powershell -ExecutionPolicy Bypass -File ./scripts/upload-dist-to-ec2.ps1 -Host your-domain.com"
  },
  "dependencies": {
    "@alloc/quick-lru": "5.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/resource": "^6.1.19",
    "@fullcalendar/resource-daygrid": "^6.1.19",
    "@fullcalendar/resource-timegrid": "^6.1.19",
    "@fullcalendar/resource-timeline": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/x-data-grid": "^8.10.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/geo": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query": "^5.85.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.11.0",
    "dayjs": "^1.11.18",
    "formik": "^2.4.6",
    "framer-motion": "^12.38.0",
    "jss-rtl": "^0.3.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-pro-sidebar": "^1.1.0",
    "react-router-dom": "^6.30.1",
    "react-toastify": "^11.0.5",
    "stylis-plugin-rtl": "^2.1.1",
    "tailwindcss": "^4.1.12",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "vite": "^7.1.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.madrasti.mms",
    "productName": "MMS",
    "executableName": "MMS",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron-resources/",
        "to": "electron-resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron-resources/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
